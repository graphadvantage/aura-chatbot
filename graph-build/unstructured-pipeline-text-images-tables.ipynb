   "source": [
    "## 4. Generate Vector Embeddings for Chunks"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 93,
   "id": "22199c7c",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      " embedding chunk: {'cdeb2a997a66d9735016872d3ec7f12b'}done!\n"
     ]
    }
   ],
   "source": [
    "#for this demo we are not embedding extracted text for :Images and :Tables\n",
    "#vector embeddings\n",
    "#pip install “neo4j_graphrag[openai]\n",
    "\n",
    "from neo4j import GraphDatabase\n",
    "from neo4j_graphrag.embeddings import OpenAIEmbeddings\n",
    "from dotenv import load_dotenv\n",
    "import os\n",
    "import logging, sys\n",
    "logging.disable(sys.maxsize)\n",
    "\n",
    "embedder = OpenAIEmbeddings(model=\"text-embedding-ada-002\", api_key=openai_api_key)\n",
    "\n",
    "driver = GraphDatabase.driver(neo4j_uri, auth=(neo4j_user, neo4j_password))\n",
    "\n",
    "#UnstructuredElement\n",
    "#Chunk\n",
    "\n",
    "with driver.session() as session:\n",
    "    res = session.run(\n",
    "        \"\"\"\n",
    "        MATCH (n:Chunk:NarrativeText)\n",
    "        WHERE n.text IS NOT NULL AND n.embedding IS NULL\n",
    "        RETURN n.id as id, n.text as data\n",
    "        \"\"\"\n",
    "    )\n",
    "    for record in res:\n",
    "        chunk_id = record[\"id\"]\n",
    "        data = record[\"data\"]\n",
    "        if len(data) > 12000:\n",
    "            print(f\"Skipping chunks {chunk_id} with data length {len(data)}\")\n",
    "            continue\n",
    "        \n",
    "        print(\"%s %s\" % ('\\r embedding chunk:',{chunk_id}), end = \"\", flush = True)\n",
    "        \n",
    "        embedding = embedder.embed_query(data)\n",
    "        \n",
    "        session.run(\n",
    "            \"\"\"\n",
    "            MATCH (n:Chunk:NarrativeText {id: $chunk_id})\n",
    "            SET n.embedding = $embedding\n",
    "            \"\"\",\n",
    "            chunk_id=chunk_id,\n",
    "            embedding=embedding\n",
    "        )\n",
    "\n",
    "session.close()\n",
    "\n",
    "print(\"done!\")       \n"
   ]
  },
