   "cell_type": "markdown",
   "id": "eb8982f4-986d-4f2a-b767-c64f2a8a1fe7",
   "metadata": {},
   "source": [
    "## 3. Chunk PDFs with Unstructured into Neo4j"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 91,
   "id": "b8d2e95d-d4dc-41df-b7e9-6923be3381bc",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Processed file: Discovery_report.pdf\n",
      "done!\n"
     ]
    }
   ],
   "source": [
    "#Use the Unstructured.io to extract NarrativeText, Image and Table elements from technical document PDFs\n",
    "#and load them into Neo4j. We are creating [:NEXT_CHUNK] relationships to store the sequence of the chunks \n",
    "#and [:PART_OF_DOCUMENT] relationships to store their provenance.\n",
    "\n",
    "import os\n",
    "import logging, sys\n",
    "logging.disable(sys.maxsize)\n",
    "\n",
    "from neo4j import GraphDatabase\n",
    "from json import dumps, loads\n",
    "\n",
    "import unstructured_client\n",
    "from unstructured_client.models import operations, shared\n",
    "\n",
    "\n",
    "directory_path = \"/Users/michaelmoore/Projects/oxy/15-9-F14/input/\"\n",
    "\n",
    "client = unstructured_client.UnstructuredClient(\n",
    "    api_key_auth=unstructured_api_key,\n",
    "    server_url=\"https://api.unstructuredapp.io\",\n",
    ")\n",
    "\n",
    "\n",
    "# Neo4j driver setup\n",
    "driver = GraphDatabase.driver(neo4j_uri, auth=(neo4j_user, neo4j_password))\n",
    "\n",
    "query0 = '''\n",
    "WITH apoc.convert.fromJsonList($json) AS maps\n",
    "UNWIND maps AS map\n",
    "CALL(map){\n",
    "WITH apoc.map.clean(map,[],[\"  \",\"\"]) AS m\n",
    "WHERE NOT m.type IN [\"Title\",\"Header\",\"Footer\",\"PageNumber\",\"ListItem\",\"Formula\",\"UncategorizedText\"]\n",
    "CREATE (n:Chunk {id:m.element_id})\n",
    "SET \n",
    "n.type=m.type,\n",
    "n.text=m.text,\n",
    "n.filetype=m.metadata.filetype,\n",
    "n.languages=m.metadata.languages,\n",
    "n.page_number=m.metadata.page_number,\n",
    "n.image_base64=m.metadata.image_base64,\n",
    "n.image_mime_type=m.metadata.image_mime_type,\n",
    "n.text_as_html=m.metadata.text_as_html,\n",
    "n.parent_id=m.metadata.parent_id,\n",
    "n.filename=m.metadata.filename\n",
    "WITH n\n",
    "CALL apoc.create.addLabels( n, [ n.type ] ) YIELD node\n",
    "RETURN node, n.filename AS doc\n",
    "}\n",
    "WITH doc, COLLECT(node) AS nodes\n",
    "CALL apoc.nodes.link(nodes, \"NEXT_CHUNK\")\n",
    "WITH doc, nodes\n",
    "MERGE (d:Document {name: doc})\n",
    "WITH d,nodes\n",
    "UNWIND nodes AS n\n",
    "CREATE (n)-[:PART_OF_DOCUMENT]->(d)\n",
    "'''\n",
    "\n",
    "def run_query(tx):\n",
    "    result = tx.run(query0, {\"json\": json})\n",
    "    for record in result:\n",
    "        print(record)\n",
    "    return result.consume()\n",
    "\n",
    "with driver.session(database = neo4j_database) as session:\n",
    "\n",
    "    for filename in os.listdir(directory_path):\n",
    "        # Skip hidden files (starting with '.')\n",
    "        if filename.startswith('.'):\n",
    "            continue\n",
    "\n",
    "        filepath = os.path.join(directory_path, filename)\n",
    "\n",
    "        # Skip if it's not a regular file\n",
    "        if not os.path.isfile(filepath):\n",
    "            continue\n",
    "\n",
    "        with open(filepath, \"rb\") as f:\n",
    "            files = shared.Files(\n",
    "                content=f.read(),\n",
    "                file_name=filename,\n",
    "                element_dicts=[]\n",
    "            )\n",
    "\n",
    "            for file in files:  \n",
    "                # the Unstructured Partitioner shreds the PDF extracting text, images & tables \n",
    "                req = operations.PartitionRequest(\n",
    "                    partition_parameters = shared.PartitionParameters(\n",
    "                    files=files,\n",
    "                    element_exclude: ['Title','Header','Footer','PageNumber','ListItem','Formula','UncategorizedText'],    \n",
    "                    metadata_include=['text_as_html','image_base64','page_number','image_mime_type','parent_id','filename'],\n",
    "                    extract_image_block_types=[\"Image\", \"Table\"],\n",
    "                )\n",
    "            )\n",
    "            \n",
    "            res = client.general.partition(request=req)\n",
    "           \n",
    "            element_dicts = [element for element in res.elements]\n",
    "\n",
    "            # We'll pass the entire Untructured output dict as a JSON array to Neo4j\n",
    "            # The Neo4j CALL(){} allows us to iterate through the array, and we can also create\n",
    "            # the :NEXT_CHUNK relationship by collecting the nodes created from the input array\n",
    "            # to keep things clean, we'll not create chunks for titles, headers, footers, and page numbers\n",
    "            \n",
    "            json = dumps(element_dicts, indent = 4)\n",
    "\n",
    "            session.execute_write(run_query)\n",
    "\n",
    "            print(f\"Processed file: {filename}\")\n",
    "\n",
    "session.close() \n",
    "\n",
    "print(\"done!\")\n",
    "        \n",
    "        "
   ]
  },
