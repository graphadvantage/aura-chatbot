    "#e'll only push :Chunks:NarrativeText for GraphRAG summarization, so we'll filter out :Images and :Tables\n",
    "#also a bunch of the images are uninteresting logos so we'll add a filtering property for the frontend.\n",
    "\n",
    "from neo4j import GraphDatabase\n",
    "\n",
    "# Neo4j driver setup\n",
    "driver = GraphDatabase.driver(neo4j_uri, auth=(neo4j_user, neo4j_password))\n",
    "\n",
    "with driver.session() as session:\n",
    "    res = session.run(process_me)\n",
    "session.close() \n",
    "print(\"done!\")\n",
    "\n",
    "query4 = '''\n",
    "MATCH (n:Image|Table) REMOVE n:Chunk\n",
    "'''\n",
    "\n",
    "#create filter for all small images like logos and other scan artifacts\n",
    "query5 = '''\n",
    "MATCH (n:Image) \n",
    "WHERE apoc.text.byteCount(n.image_base64) < (1024*9)\n",
    "SET  n.is_logo=\"yes\"\n",
    "'''\n",
    "\n",
    "with driver.session() as session:\n",
    "    res = session.run(query4)\n",
    "    res.consume()\n",
    "    res = session.run(query5)\n",
    "    res.consume()\n",
    "session.close()\n",
    "\n",
    "print(\"done!\")\n"
   ]
